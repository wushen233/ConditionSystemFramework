        ],
        "listPriority": 200
      }
    ],
    "Weapon.Handling.Unarmed": [
      {
        // 徒手装备主体形态。
        "list": "Condition System Framework.esp|0x000F82",
        "contexts": [
          "base",
          "instance"
        ],
        "listPriority": 200
      }
    ],
    "Weapon.Configuration.Shotgun": [
      {
        // 可由基础 WEAP 或当前实例的枪管、机匣、弹匣产生。
        "list": "Condition System Framework.esp|0x000F78",
        "contexts": [
          "base",
          "instance"
        ],
        "listPriority": 200
      }
    ],
    "Weapon.Configuration.Sniper": [
      {
        // 只依赖明确配置，不根据瞄准镜或枪管长度猜测。
        "list": "Condition System Framework.esp|0x000F79",
        "contexts": [
          "base",
          "instance"
        ],
        "listPriority": 200
      }
    ]
  }
}
