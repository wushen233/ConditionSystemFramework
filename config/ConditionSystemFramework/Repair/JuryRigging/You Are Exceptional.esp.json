      "Priority": 250,
      "MaterialConditionMultiplier": 1.0,
      "RequiredSkill": {
        "Type": "AV",
        "Plugin": "You Are Exceptional.esp",
        "FormID": "0x07AE50",
        "ScaleFactor": 100.0
