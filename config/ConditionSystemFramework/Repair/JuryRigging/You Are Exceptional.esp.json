      "Compatibility": {
        "all": [
          { "type": "sameGroup", "group": "Armor.Region" },
          { "type": "sameGroup", "group": "Armor.Material" },
          { "type": "sameOptionalGroup", "group": "Armor.Grade" }
        ]
      }
    },
