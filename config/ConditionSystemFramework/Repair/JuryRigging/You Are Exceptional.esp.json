      "RuleName": "Ballistic/Launcher: Same Handling (Gunsmithery 20)",
      "Priority": 200,
      "MaterialConditionMultiplier": 0.8,
      "RequiredSkill": {
        "Type": "AV",
        "Plugin": "You Are Exceptional.esp",
        "FormID": "0x000008",
        "ScaleFactor": 100.0
      },
      "SkillThresholds": [{ "threshold": 20.0, "maxValue": 1.0 }],
