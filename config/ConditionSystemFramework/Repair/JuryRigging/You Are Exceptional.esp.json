{
  /*
   * You Are Exceptional 技能 Provider。
   * Gunsmithery 负责 Ballistic/Launcher，Science 负责高级技术，
   * Weaponry 负责 Melee/Unarmed。混合技术武器可使用任意满足的路线。
   */
  "RequiredPlugin": "You Are Exceptional.esp",
  "schemaVersion": 3,
  "module": "Repair.JuryRigging",
  "ProviderPriority": 100,
  "JuryRiggingRules": [
    {
      "RuleName": "Exact Base Weapon With Same Handling",
      "Priority": 300,
      "MaterialConditionMultiplier": 1.0,
      "AppliesTo": {
        "target": { "all": ["weapon"], "none": ["Weapon.Flag.Ignore"] },
        "material": { "all": ["weapon"], "none": ["Weapon.Flag.Ignore"] }
      },
      "Compatibility": {
        "all": [
          { "type": "sameBase" },
          { "type": "sameGroup", "group": "Weapon.Handling" }
        ]
      }
    },
    {
      "RuleName": "Exact Base Armor",
      "Priority": 300,
      "MaterialConditionMultiplier": 1.0,
      "AppliesTo": {
        "target": { "all": ["armor"], "none": ["Armor.Flag.Ignore"] },
        "material": { "all": ["armor"], "none": ["Armor.Flag.Ignore", "Armor.Flag.NoDonor"] }
      },
      "Compatibility": { "all": [{ "type": "sameBase" }] }
    },
    {
