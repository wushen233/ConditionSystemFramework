{
  "JuryRiggingRules": [
    {
      "RuleName": "Guns Stage 3 Late (Level 100): Universal Repair (100% Efficiency)",
      "Description": "Any ranged firearm can repair any other, across weapon types and energy/ballistic categories, at full efficiency.",
      "TargetKeywords": [
        "WeaponTypePistol", "WeaponTypeRifle", "WeaponTypeSniper", "WeaponTypeShotgun",
        "WeaponTypeHeavyGun", "WeaponTypeAssaultRifle", "WeaponTypeLaser", "WeaponTypePlasma"
      ],
      "MatchCategories": [],
      "MaterialConditionMultiplier": 1.0,
      "RequiredSkill": {
        "Type": "AV", "Plugin": "Classic Skill System.esp", "FormID": "FA0", "MinLevel": 100
      }
    },
    {
      "RuleName": "Guns Stage 3 Early (Level 75): Cross-Type Repair (80% Efficiency)",
      "Description": "Pistols may repair rifles, and ballistic weapons may repair energy weapons, but 20% condition efficiency is lost.",
      "TargetKeywords": [
        "WeaponTypePistol", "WeaponTypeRifle", "WeaponTypeSniper", "WeaponTypeShotgun",
        "WeaponTypeHeavyGun", "WeaponTypeAssaultRifle", "WeaponTypeLaser", "WeaponTypePlasma"
      ],
