{
  "OverRepairRules": [
    {
      "RuleName": "Over-Repair Firearms (Gun Nut)",
      // TargetKeywords：只有带有这些关键词的武器才受本规则管辖。
      // TargetKeywords: only weapons with these keywords are covered by this rule.
      "TargetKeywords": [
        "WeaponTypePistol",   "WeaponTypeRifle",    "WeaponTypeShotgun",
        "WeaponTypeHeavyGun"
      ],
      // RequiredSkill：决定本规则读取玩家的哪种能力。
      // RequiredSkill: determines the player capability used for this rule.
      // "Type": "Perk" 读取 Perk 等级；"AV" 读取力量、敏捷等 Actor Value。
      // "Type": "Perk" reads perk rank; "AV" reads an actor value such as Strength or Agility.
      // "FormID" 是辐射 4 原版“枪支迷”的 Perk ID。
      // "FormID" is Fallout 4's vanilla Gun Nut perk ID.
      "RequiredSkill": {
        "Type"  : "Perk",
        "Plugin": "Fallout4.esm",
        "FormID": "0x0004A0DA"
      },
      // AVStep：Actor Value 步长。Perk 规则使用等级，不使用该值。
      // AVStep: actor value step size. Perk rules use rank instead.
      "AVStep": 25,
      // RankLimits：各技能等级对应的状况上限。
      // RankLimits: maximum condition by skill rank.
      // 索引 0 代表无 Perk，上限 100% (1.0)。
      // Index 0 means no perk and a 100% limit (1.0).
      // 索引 1 代表等级 1，上限 125% (1.25)。
      // Index 1 means rank 1 and a 125% limit (1.25).
      // 索引 4 代表等级 4，上限 200% (2.0)。
      // Index 4 means rank 4 and a 200% limit (2.0).
      "RankLimits": [1.0, 1.25, 1.50, 1.75, 2.0]
    },
    {
      "RuleName": "Over-Repair Melee Weapons (Blacksmith)",
      "TargetKeywords": [
        "WeaponTypeMelee1H", "WeaponTypeMelee2H", "WeaponTypeUnarmed"
      ],
      "RequiredSkill": {
        "Type"  : "Perk",
        "Plugin": "Fallout4.esm",
        "FormID": "0x0004B253" // “铁匠” FormID (Blacksmith01)。旧值 0x0004A0D5 实为 ChemResistant01。 / Blacksmith FormID.
      },
      "AVStep": 25,
      "RankLimits": [1.0, 1.25, 1.50, 1.75, 2.0]
    },
    {
      "RuleName": "Over-Repair Armor and Power Armor (Armorer)",
      "TargetKeywords": [
        "ArmorTypeLeather", "ArmorTypeMetal",   "ArmorTypeCombat",
        "ArmorTypeRaider",  "ArmorTypeSynth",   "ArmorTypePower"
      ],
      "RequiredSkill": {
        "Type"  : "Perk",
        "Plugin": "Fallout4.esm",
        "FormID": "0x0004B254" // “装甲商” FormID (Armorer01)。旧值 0x0004A0CB 实为 DamageTypeEnergy 关键字。 / Armorer FormID.
      },
      "AVStep": 25,
      "RankLimits": [1.0, 1.30, 1.60, 1.80, 2.0]
    }
  ]
}
