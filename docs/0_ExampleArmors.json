{
  "description": "护甲耐久配置示例 / Armor Durability Profile Example",
  "profiles": [
    // =========================================================================
    // 示例：军用战斗护甲 / Example: Military Combat Armor
    // =========================================================================
    {
      "name": "Combat Armor",
      "priority": 90,
      "maxDurability": 1200.0,     // 军用品质，高耐久 / Military-grade, high durability
