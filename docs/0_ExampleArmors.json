      "keywords": [
        ["ArmorTypeCombat"],
        ["ArmorMaterialCombat"],
        ["DLC03_ArmorTypeMarine"]   // 远港水手护甲也属于此类 / Far Harbor marine armor also fits here
      ],
      "formIDs": []
    },
    // =========================================================================
    // 示例：金属/合成材料硬质护甲 / Example: Hard Metal & Synth Armor
    // =========================================================================
    {
      "name": "Hard Metal / Synth Armor",
      "priority": 70,
      "maxDurability": 900.0,
      "useFlatDegrade": false,
      "degradeRate": 0.0,
      "keywords": [
        ["ArmorTypeMetal"],
        ["ArmorTypeSynth"],
        ["ArmorMaterialMetal"]
      ],
      "formIDs": []
