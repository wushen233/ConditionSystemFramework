    // =========================================================================
    // 示例：服装与内衬 / Example: Clothing & Underarmor
    // =========================================================================
    {
      "name": "Clothing / Underarmor",
      "priority": 30,
      "maxDurability": 300.0,      // 布料防护有限，耐久很低 / Cloth has limited durability
